<Project>

  <!--
    Applies to every project under src/ only.
    Deliberately NOT at the repo root: the legacy course-* folders pin their own
    TargetFramework / package versions and must keep building untouched.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!--
      IDE0005 (unnecessary using) only runs at build time when the XML doc file
      is generated. CS1591 is the "missing XML comment on public member" nag that
      comes with it, which is not worth it for sample code.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- bin/ and obj/ are redirected into src/artifacts/ instead of scattering per project. -->
  <PropertyGroup>
    <UseArtifactsOutput>true</UseArtifactsOutput>
  </PropertyGroup>

</Project>
